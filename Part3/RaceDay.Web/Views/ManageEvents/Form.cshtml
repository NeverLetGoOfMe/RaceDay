@model EventFormVm
@{
    var isNew = Model.EventId == 0;
    ViewData["Title"] = isNew ? "Create event" : "Edit event";
}
<div class="rd-hero"><h1>@ViewData["Title"]</h1><p>Tell participants what to expect.</p></div>

<div class="card rd-card"><div class="card-body">
    <form asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@Model.EventId" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
        <input type="hidden" asp-for="ExistingBanner" />
        <div class="row">
            <div class="col-md-8 mb-3">
                <label asp-for="EventName" class="form-label"></label>
                <input asp-for="EventName" class="form-control" />
                <span asp-validation-for="EventName" class="text-danger"></span>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="EventType" class="form-label"></label>
                <select asp-for="EventType" class="form-select">
                    <option value="Run">Run</option>
                    <option value="Walk">Walk</option>
                    <option value="Cycle">Cycle</option>
                </select>
                <span asp-validation-for="EventType" class="text-danger"></span>
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="EventDate" class="form-label"></label>
                <input asp-for="EventDate" type="date" class="form-control" />
                <span asp-validation-for="EventDate" class="text-danger"></span>
            </div>
            <div class="col-md-5 mb-3">
                <label asp-for="Location" class="form-label"></label>
                <input asp-for="Location" class="form-control" />
                <span asp-validation-for="Location" class="text-danger"></span>
            </div>
            <div class="col-md-3 mb-3">
                <label asp-for="Distance" class="form-label"></label>
                <input asp-for="Distance" type="number" step="0.1" class="form-control" />
                <span asp-validation-for="Distance" class="text-danger"></span>
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="RouteInfo" class="form-label"></label>
            <input asp-for="RouteInfo" class="form-control" />
            <span asp-validation-for="RouteInfo" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Banner" class="form-label"></label>
            @if (!string.IsNullOrEmpty(Model.ExistingBanner))
            {
                <div class="mb-2"><img src="@Url.Action("Get", "Images", new { id = Model.ExistingBanner })" alt="Current banner" style="max-height:120px;border-radius:0.5rem;" /></div>
            }
            <input asp-for="Banner" type="file" accept="image/jpeg,image/png,image/webp" class="form-control" />
            <div class="form-text">JPEG, PNG or WebP, up to 5 MB. Leave empty to keep the current banner.</div>
        </div>
        <button type="submit" class="btn btn-rd">@(isNew ? "Create event" : "Save changes")</button>
        <a asp-action="Index" class="btn btn-outline-rd">Cancel</a>
    </form>
</div></div>
