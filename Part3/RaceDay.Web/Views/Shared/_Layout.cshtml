@{
    var role = Context.Session.Role();
    var loggedIn = Context.Session.UserId() != null;
    var picture = Context.Session.Picture();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
<nav class="navbar navbar-expand-lg rd-navbar navbar-dark">
    <div class="container">
        <a class="navbar-brand" asp-controller="Events" asp-action="Index">Race<span>Day</span></a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav" aria-controls="nav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="nav">
            <ul class="navbar-nav me-auto">
                @if (loggedIn && role == "Organiser")
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="Dashboard">Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="ManageEvents" asp-action="Index">My Events</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="ManageEvents" asp-action="Create">Create Event</a></li>
                }
                else if (loggedIn)
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Events" asp-action="Index">Upcoming Events</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Enrolments" asp-action="My">My Enrolments</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Results" asp-action="My">My Results</a></li>
                }
            </ul>
            <ul class="navbar-nav align-items-lg-center">
                @if (loggedIn)
                {
                    <li class="nav-item d-flex align-items-center me-lg-3">
                        @if (picture != null)
                        {
                            <img class="rd-avatar me-2" src="@Url.Action("Get", "Images", new { id = picture })" alt="Profile picture" />
                        }
                        <a class="nav-link" asp-controller="Profile" asp-action="Index">@Context.Session.FullName() <small class="text-warning">(@role)</small></a>
                    </li>
                    <li class="nav-item">
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="btn btn-sm btn-outline-light">Log out</button>
                        </form>
                    </li>
                }
                else
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Log in</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Register">Register</a></li>
                }
            </ul>
        </div>
    </div>
</nav>

<main class="container py-4">
    @await Html.PartialAsync("_Alerts")
    @RenderBody()
</main>

<footer class="container rd-footer text-center">RaceDay &middot; South African road running, walking and cycling events</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
