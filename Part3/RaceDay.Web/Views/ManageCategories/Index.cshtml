@model CategoriesPageVm
@{
    ViewData["Title"] = "Categories";
}
<div class="mb-3"><a asp-controller="ManageEvents" asp-action="Index" class="text-decoration-none">&larr; My events</a></div>
<div class="rd-hero"><h1>Categories</h1><p>@Model.Event.EventName &middot; @Model.Event.EventDate.ToString("d MMM yyyy")</p></div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card rd-card"><div class="card-body">
            <h4>Current categories</h4>
            @if (!Model.Categories.Any())
            {
                <p class="text-muted mb-0">No categories yet. Add age or distance groups such as Under 20, Senior or 10km.</p>
            }
            else
            {
                <table class="table mb-0">
                    <thead><tr><th>Name</th><th>Places</th><th>Fee</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var c in Model.Categories)
                    {
                        <tr>
                            <td>@c.CategoryName</td>
                            <td>@c.MaxParticipants</td>
                            <td>@Format.Money(c.EntryFee)</td>
                            <td class="text-end">
                                <form asp-action="Delete" asp-route-id="@c.CategoryId" asp-route-eventId="@Model.Event.EventId" method="post" onsubmit="return confirm('Remove this category?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </div></div>
    </div>
    <div class="col-lg-5">
        <div class="card rd-card"><div class="card-body">
            <h4>Add a category</h4>
            <form asp-action="Create" asp-route-eventId="@Model.Event.EventId" method="post">
                <div class="mb-3">
                    <label asp-for="Form.CategoryName" class="form-label"></label>
                    <input asp-for="Form.CategoryName" class="form-control" />
                    <span asp-validation-for="Form.CategoryName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Form.MaxParticipants" class="form-label"></label>
                    <input asp-for="Form.MaxParticipants" type="number" class="form-control" />
                    <span asp-validation-for="Form.MaxParticipants" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Form.EntryFee" class="form-label"></label>
                    <input asp-for="Form.EntryFee" type="number" step="0.01" class="form-control" />
                    <span asp-validation-for="Form.EntryFee" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-rd">Add category</button>
            </form>
        </div></div>
    </div>
</div>
