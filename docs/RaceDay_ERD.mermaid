erDiagram
    ROLES ||--o{ USERS : "has"
    USERS ||--o{ EVENTS : "organises"
    EVENTS ||--o{ CATEGORIES : "offers"
    CATEGORIES ||--o{ ENROLMENTS : "receives"
    USERS ||--o{ ENROLMENTS : "makes"
    ENROLMENTS ||--|| RESULTS : "produces"
    USERS ||--o{ RESULTS : "captures"

    ROLES {
        int RoleId PK
        varchar RoleName
    }
    USERS {
        int UserId PK
        int RoleId FK
        varchar FullName
        varchar Email
        varchar PasswordHash
        varchar ContactNumber
        datetime CreatedDate
    }
    EVENTS {
        int EventId PK
        int OrganiserId FK
        varchar EventName
        date EventDate
        varchar Location
        varchar Description
        varchar RouteInfo
        decimal Distance
        varchar EventType
        datetime CreatedDate
    }
    CATEGORIES {
        int CategoryId PK
        int EventId FK
        varchar CategoryName
        int MaxParticipants
        decimal EntryFee
    }
    ENROLMENTS {
        int EnrolmentId PK
        int ParticipantId FK
        int CategoryId FK
        datetime EnrolmentDate
        varchar Status
    }
    RESULTS {
        int ResultId PK
        int EnrolmentId FK
        time FinishTime
        int Position
        int CapturedByUserId FK
        datetime CapturedDate
    }
